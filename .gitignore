# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/

# NOTE: the vector DB (hci_chroma_db_local/) and the COMP3423 lecture PDFs are
# intentionally committed (Wilson, 2026-06-18) so a fresh clone runs RAG with no
# out-of-band files. PUBLIC repo — these are PolyU course materials.

# Next.js
frontend/.next/
frontend/out/
frontend/build/

# Node
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Env
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Logs & local debug scripts (build noise, not source)
*.log
*.err
frontend/test-*.mjs

# Research sink — local runtime data (participant events), not source
backend/research_events.db

# Participant accounts — runtime data, not source
backend/auth_store.db
# PERSONAL DATA. Real student SIDs, one per line. Committing this is a PDPO /
# PolyU data-protection incident, and git history makes it unrecoverable.
backend/enrolled_sids.txt
# Teacher allowlist -- names real people, same reasoning as the class list above.
backend/admin_sids.txt
# HMAC key for participant pseudonyms. Must be backed up OFF this machine —
# lose it and no future export can be joined to any past one — but never to git,
# or the pseudonyms in the export are trivially reversible back to SIDs.
backend/.participant_secret
# DB backup left by rebuild_db.py — redundant with the regenerable DB
backend/hci_chroma_db_local.bak/
# Render-verification artifacts — screenshots + reports are generated, not source
frontend/scripts/shots/
frontend/scripts/render-report.json
frontend/scripts/vlm-report.json
# Ad-hoc verification screenshots dropped in the frontend root — not source
frontend/*.png

# Stray packed ELF executable (statically-linked, stripped, no section header,
# 1.3MB) accidentally committed in 6987bcc — has no business in a Next.js
# frontend. Untracked 2026-06-23; ignore so it can't sneak back in.
frontend/let

# Per-run scratch dirs created by backend/tests (sqlite fixtures, HMAC secret)
backend/tests/_tmp_*/

# Local end-to-end run artefacts: scratch DBs, HMAC secrets, shifted schedules,
# the standalone dev server. Anything the verification runs create.
backend/_dev*
backend/_verify*
backend/_devserver.py
backend/*.bak

# Local DB snapshots from backup_sink.py
backups/

# Stray binaries / file-transfer residue in frontend/. A UPX-packed static Linux
# ELF was committed on 2026-06-18 inside a commit titled "Increase font sizes for
# game readability" (6987bcc); a second, different one appeared 2026-08-19.
# Nothing in this repo fetches them. Quarantined, not deleted -- see
# docs/incident-2026-08-21-stray-binary.md
frontend/let
frontend/let;chmod
frontend/.b
*.elf

# Grading output and teacher reports. BOTH CONTAIN VERBATIM STUDENT ANSWERS and
# the teacher version carries real SIDs (docs/revamp.md Part 12). Never tracked.
reports/

# deploy runtime — logs and machine-local settings, never the repo
deploy/logs/
deploy/.env.local
data/
